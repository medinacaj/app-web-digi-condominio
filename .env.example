# Variables de ejemplo para desarrollo LOCAL: no incluya contraseñas reales en archivos.
# Configure las siguientes directamente en su entorno de terminal antes del bootstrap.
# DIGI_ADMIN_EMAIL=admin@example.test
# DIGI_ADMIN_PASSWORD=REEMPLAZAR_EN_EL_ENTORNO
# DIGI_COMMUNITY_NAME=Comunidad de prueba
# DIGI_DB_PATH=.data/condominio.sqlite
# PORT=4173

# Piloto alojado: valores reales solo en ajustes privados del hosting, nunca en Git.
# DIGI_PUBLIC_ORIGIN=https://URL_REAL_DEL_SERVICIO
# DIGI_DB_PATH=/data/condominio.sqlite
# DIGI_HOST=0.0.0.0
# DIGI_TRUST_PROXY=1
# DIGI_MAIL_FROM=REMITENTE_VERIFICADO
# DIGI_MAIL_API_KEY=CONFIGURAR_COMO_SECRETO_EN_EL_HOSTING
# DIGI_ACCOUNT_KIND=independent
# DIGI_ACCOUNT_NAME=Nombre del cliente de prueba
# Suscripción asistida: metadatos, no realiza cobros.
# DIGI_SUBSCRIPTION_ACCOUNT=UUID_DE_LA_CUENTA
# DIGI_SUBSCRIPTION_PLAN=Nombre_del_plan_aprobado
# DIGI_SUBSCRIPTION_STATUS=trial
